{
  "name": "password-manager",
  "private": true,
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "setup": "node scripts/setup-env.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "api": "node --env-file=.env scripts/run-api.js",
    "web": "cd frontend && npm run dev",
    "start": "npm run setup && npm run db:up && concurrently --kill-others-on-fail -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "start:nodb": "npm run setup && concurrently --kill-others-on-fail -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "cap:build": "npm --prefix frontend run cap:build",
    "cap:open": "npm --prefix frontend run cap:open",
    "cap:run": "npm --prefix frontend run cap:run",
    "test:api": "node --env-file=.env scripts/run-api.js test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
